[Unit]
Description=Cathedral SN39 signed policy freshness republisher
Documentation=https://github.com/cathedralai/cathedralconfidential/blob/main/docs/POLICY_REGISTRY.md
After=local-fs.target
ConditionPathExists=/etc/cathedral/policy-registry-sn39.json
ConditionPathExists=/etc/cathedral/policy-signing-sn39.key

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Restart=on-failure
RestartSec=5min

# This unit runs as root, so every path it executes must be root-owned all
# the way up. An interpreter or script under a user-writable directory is
# that user's code running as root at the next timer firing, whatever the
# file's own mode says. ProtectHome=read-only does not help: it stops this
# service writing /home, not the owner of /home writing it first.
#
# The deployment root therefore lives under /opt, and this preflight refuses
# to start if the chain is ever loosened. It is deliberately ExecStartPre and
# not documentation: a check an operator has to remember to run is a check
# that is not run.
ExecStartPre=/opt/cathedral-sn39/.venv/bin/python -m cathedral.privileged_paths \
    /opt/cathedral-sn39/.venv/bin/python \
    /opt/cathedral-sn39/scripts/cathedral_measurement_approval.py \
    /etc/cathedral/policy-registry-sn39.json \
    /etc/cathedral/policy-signing-sn39.key
# site-packages is not an ancestor of the interpreter or the script, so the
# check above does not reach it — and it is the directory root actually
# imports every cathedral.* module from, and the one pip most often leaves
# owned by the deploying user. Adjust the python version in this path to
# match the venv.
ExecStartPre=/opt/cathedral-sn39/.venv/bin/python -m cathedral.privileged_paths --directory \
    /opt/cathedral-sn39/.venv/lib/python3.11/site-packages
ExecStart=/opt/cathedral-sn39/.venv/bin/python /opt/cathedral-sn39/scripts/cathedral_measurement_approval.py republish-install --registry /etc/cathedral/policy-registry-sn39.json --signing-key-file /etc/cathedral/policy-signing-sn39.key --state /var/lib/cathedral-confidential-sn39/policy-state.sqlite --operator cathedral-sn39-systemd --reason "scheduled bounded 24-hour freshness reissue" --approval-log /var/lib/cathedral-confidential-sn39/policy-republication.jsonl --history-dir /var/lib/cathedral-confidential-sn39/policy-history --lock-file /var/lib/cathedral-confidential-sn39/policy-writer.lock
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
DevicePolicy=closed
NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadWritePaths=/etc/cathedral /var/lib/cathedral-confidential-sn39
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
LockPersonality=true
MemoryDenyWriteExecute=true
