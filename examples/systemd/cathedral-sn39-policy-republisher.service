[Unit]
Description=Cathedral SN39 signed policy freshness republisher
Documentation=https://github.com/cathedralai/cathedralconfidential/blob/main/docs/POLICY_REGISTRY.md
After=local-fs.target
ConditionPathExists=/etc/cathedral/policy-registry-sn39.json
ConditionPathExists=/etc/cathedral/policy-signing-sn39.key

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Restart=on-failure
RestartSec=5min

# This unit runs as root, so every path it executes must be root-owned all
# the way up. An interpreter or script under a user-writable directory is
# that user's code running as root at the next timer firing, whatever the
# file's own mode says. ProtectHome=read-only does not help: it stops this
# service writing /home, not the owner of /home writing it first.
#
# The checker is a standalone, root-installed trust anchor. Do not import it
# from the venv or source tree it is inspecting. -I -S keeps its imports in
# the OS Python standard library. See docs/PRIVILEGED_PATHS.md for the install
# command and the precise trust boundary.
#
# A standard POSIX venv uses interpreter symlinks. --resolve-symlinks verifies
# every link object, every ancestor, and the final interpreter rather than
# rejecting the standard layout or following it without inspection.
ExecStartPre=/usr/bin/python3 -I -S /usr/local/libexec/cathedral-privileged-paths.py --resolve-symlinks \
    /usr/bin/python3 \
    /usr/local/libexec/cathedral-privileged-paths.py \
    /opt/cathedral-sn39/.venv/bin/python
# These are the exact regular config and program files read by the service.
ExecStartPre=/usr/bin/python3 -I -S /usr/local/libexec/cathedral-privileged-paths.py \
    /opt/cathedral-sn39/.venv/pyvenv.cfg \
    /opt/cathedral-sn39/scripts/cathedral_measurement_approval.py \
    /etc/cathedral/policy-registry-sn39.json \
    /etc/cathedral/policy-signing-sn39.key \
    /var/lib/cathedral-confidential-sn39/policy-state.sqlite \
    /var/lib/cathedral-confidential-sn39/policy-republication.jsonl
# The lock may not exist before the first run. Its checked parent is the trust
# boundary for O_NOFOLLOW|O_CREAT; the program then validates the opened inode.
ExecStartPre=/usr/bin/python3 -I -S /usr/local/libexec/cathedral-privileged-paths.py --directory \
    /var/lib/cathedral-confidential-sn39 \
    /var/lib/cathedral-confidential-sn39/policy-history
# The program prepends /opt/cathedral-sn39 to sys.path and imports third-party
# wheels from the venv. Checking only the two parent directories would miss a
# writable cathedral/*.py or wheel file. --tree checks every descendant with
# a bounded, no-symlink descriptor walk. Adjust python3.11 to match the venv.
ExecStartPre=/usr/bin/python3 -I -S /usr/local/libexec/cathedral-privileged-paths.py --tree \
    /opt/cathedral-sn39/cathedral \
    /opt/cathedral-sn39/.venv/lib/python3.11/site-packages
# Isolated mode ignores PYTHONPATH and user site-packages, so imports stay
# inside the OS/venv/source paths checked above.
ExecStart=/opt/cathedral-sn39/.venv/bin/python -I /opt/cathedral-sn39/scripts/cathedral_measurement_approval.py republish-install --registry /etc/cathedral/policy-registry-sn39.json --signing-key-file /etc/cathedral/policy-signing-sn39.key --state /var/lib/cathedral-confidential-sn39/policy-state.sqlite --operator cathedral-sn39-systemd --reason "scheduled bounded 24-hour freshness reissue" --approval-log /var/lib/cathedral-confidential-sn39/policy-republication.jsonl --history-dir /var/lib/cathedral-confidential-sn39/policy-history --lock-file /var/lib/cathedral-confidential-sn39/policy-writer.lock
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
DevicePolicy=closed
NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadWritePaths=/etc/cathedral /var/lib/cathedral-confidential-sn39
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
LockPersonality=true
MemoryDenyWriteExecute=true
